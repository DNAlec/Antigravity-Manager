# Release assets pin AM_IMAGE to the published version.
AM_IMAGE=ghcr.io/dnalec/antigravity-manager:latest
# Set both before starting. Preserve existing production credentials when upgrading.
API_KEY=
WEB_PASSWORD=
# Reuse the existing account/config directory; back it up before upgrading.
ABV_HOST_DATA_DIR=~/.antigravity_tools
BIND_ADDRESS=127.0.0.1
PORT=8045
RUST_LOG=info
ABV_MAX_BODY_SIZE=104857600
